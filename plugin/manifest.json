{
  "id": "backup",
  "name": "Backup",
  "version": "0.1.0",
  "author": "Ervisio team",
  "description": "Scheduled, account-owned folder and PostgreSQL/MySQL/SQLite backups to saved SFTP or SMB network folders, with provenance-verified retention and background job history. Linux only.",
  "homepage": "https://github.com/Ervisio/plugin-backup",
  "minCore": "7.0.3",
  "icon": "archive",
  "color": "file",
  "entry": "index.js",
  "contributes": {
    "pages": [
      {
        "id": "backup",
        "title": "Backup",
        "icon": "archive",
        "ervisios": {
          "view": "backup-desktop"
        }
      }
    ]
  },
  "capabilities": {
    "commands": [
      {
        "name": "backup-status",
        "description": "Account-owned backup helper: status",
        "platforms": [
          "linux"
        ],
        "argv": [
          "/usr/bin/ervisiod",
          "--backup",
          "status"
        ],
        "timeoutSec": 30
      },
      {
        "name": "backup-list",
        "description": "Account-owned backup helper: list",
        "platforms": [
          "linux"
        ],
        "argv": [
          "/usr/bin/ervisiod",
          "--backup",
          "list"
        ],
        "timeoutSec": 30
      },
      {
        "name": "backup-remotes",
        "description": "Account-owned backup helper: remotes",
        "platforms": [
          "linux"
        ],
        "argv": [
          "/usr/bin/ervisiod",
          "--backup",
          "remotes"
        ],
        "timeoutSec": 30
      },
      {
        "name": "backup-save",
        "description": "Account-owned backup helper: save",
        "platforms": [
          "linux"
        ],
        "argv": [
          "/usr/bin/ervisiod",
          "--backup",
          "save",
          "{0}"
        ],
        "args": [
          {
            "pattern": "[a-f0-9]{32}",
            "maxLen": 32
          }
        ],
        "timeoutSec": 30
      },
      {
        "name": "backup-delete",
        "description": "Account-owned backup helper: delete",
        "platforms": [
          "linux"
        ],
        "argv": [
          "/usr/bin/ervisiod",
          "--backup",
          "delete",
          "{0}"
        ],
        "args": [
          {
            "pattern": "[a-f0-9]{32}",
            "maxLen": 32
          }
        ],
        "timeoutSec": 30
      },
      {
        "name": "backup-history",
        "description": "Account-owned backup helper: history",
        "platforms": [
          "linux"
        ],
        "argv": [
          "/usr/bin/ervisiod",
          "--backup",
          "history",
          "{0}"
        ],
        "args": [
          {
            "pattern": "[a-f0-9]{32}",
            "maxLen": 32
          }
        ],
        "timeoutSec": 30
      },
      {
        "name": "backup-test",
        "description": "Account-owned backup helper: test",
        "platforms": [
          "linux"
        ],
        "argv": [
          "/usr/bin/ervisiod",
          "--backup",
          "test",
          "{0}"
        ],
        "args": [
          {
            "pattern": "[a-f0-9]{32}",
            "maxLen": 32
          }
        ],
        "timeoutSec": 30
      },
      {
        "name": "backup-browse",
        "description": "Account-owned backup helper: browse",
        "platforms": [
          "linux"
        ],
        "argv": [
          "/usr/bin/ervisiod",
          "--backup",
          "browse",
          "{0}"
        ],
        "args": [
          {
            "pattern": "[a-f0-9]{32}",
            "maxLen": 32
          }
        ],
        "timeoutSec": 30
      },
      {
        "name": "backup-run",
        "description": "Account-owned backup helper: run",
        "platforms": [
          "linux"
        ],
        "argv": [
          "/usr/bin/ervisiod",
          "--backup",
          "run",
          "{0}"
        ],
        "args": [
          {
            "pattern": "[a-f0-9]{32}",
            "maxLen": 32
          }
        ],
        "timeoutSec": 600
      },
      {
        "name": "backup-tick",
        "description": "Account-owned backup helper: tick",
        "platforms": [
          "linux"
        ],
        "argv": [
          "/usr/bin/ervisiod",
          "--backup",
          "tick",
          "{0}"
        ],
        "args": [
          {
            "pattern": "[a-f0-9]{32}",
            "maxLen": 32
          }
        ],
        "timeoutSec": 600
      }
    ],
    "files": {
      "write": [
        {
          "path": "~/.config/ervisio/plugins/backup/inbox",
          "create": true,
          "platforms": [
            "linux"
          ]
        }
      ]
    },
    "jobs": [
      {
        "name": "backup",
        "description": "Scheduled backup",
        "timeoutSec": 21600,
        "params": [
          {
            "name": "backup",
            "pattern": "[a-f0-9]{32}",
            "maxLen": 32
          }
        ],
        "steps": [
          {
            "id": "archive",
            "command": "backup-tick",
            "args": [
              "{param.backup}"
            ],
            "timeoutSec": 21600
          }
        ]
      },
      {
        "name": "backup-once",
        "description": "Manual backup independent of next due date",
        "timeoutSec": 21600,
        "params": [
          {
            "name": "backup",
            "pattern": "[a-f0-9]{32}",
            "maxLen": 32
          }
        ],
        "steps": [
          {
            "id": "archive",
            "command": "backup-run",
            "args": [
              "{param.backup}"
            ],
            "timeoutSec": 21600
          }
        ]
      }
    ]
  },
  "platforms": [
    "linux"
  ]
}
